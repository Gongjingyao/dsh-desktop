build/
release/
dist/

# 自检产生的临时目录
_selftest/

# 运行时/日志（正常不会出现在这里，兜底）
logs/
*.log

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 本地环境覆盖
.env
.env.local
